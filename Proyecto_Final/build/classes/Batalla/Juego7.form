              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="A lo lejos ves al dragon huyendo mal herido, mientras observas como el castillo va &#xa;disminuyendo, notas que la mayor parte del castillo eran en si el dragon, aun asi la &#xa;luz del alba ba&#xf1;a las paredes, dandote una sensacion indescriptible, al fondo ves la &#xa;salida, pero te viene a la mente esto &#xbf;quedarme y ser uno con el castillo o regresar&#xa;a casa?&#xa;"/>
                <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                  <Border info="org.netbeans.modules.form.compat2.border.MatteColorBorderInfo">
                    <MatteColorBorder>
                      <Color PropertyName="color" blue="0" green="ff" red="66" type="rgb"/>
                    </MatteColorBorder>
                  </Border>
                </Property>
              </Properties>
            </Component>
