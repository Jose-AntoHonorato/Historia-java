            <Component class="javax.swing.JTextArea" name="txtprologo">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="El castillo empieza a deformarse , las paredes empiezan a encogerse que poco a poco&#xa;sientes que te falta el aire, pero sorprendentemente no mueres si no que tu cuerpo&#xa;va cambiando, tu piel luze cada vez mas como una piedra, desesperado intentas&#xa;acuchillarte pero tu piel dura te lo impide, te desmayas y despiertas, pero diferente&#xa;puedes ver todas las habitaciones del castillo pero no tu cuerpo, de pronto, todo se &#xa;oscurece, y se ve la misma puerta por la que entraste. ves una persona, intentas advertirle&#xa;pero solo logras emitir un gru&#xf1;ido que hace que la otra persona solo avance mas."/>
                <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                  <Border info="org.netbeans.modules.form.compat2.border.MatteColorBorderInfo">
                    <MatteColorBorder>
                      <Color PropertyName="color" blue="0" green="ff" red="66" type="rgb"/>
                    </MatteColorBorder>
                  </Border>
                </Property>
              </Properties>
            </Component>
